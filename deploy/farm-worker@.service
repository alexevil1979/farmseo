[Unit]
Description=Farm Chrome worker instance %i (Node.js / Puppeteer / CDP)
Documentation=file:///opt/farm/docs/operations.md
After=network.target mysql.service redis-server.service redis.service farm-api.service
Wants=redis-server.service farm-api.service
StartLimitIntervalSec=120
StartLimitBurst=8

[Service]
Type=simple
User=farm
Group=farm
WorkingDirectory=/opt/farm/workers
EnvironmentFile=-/opt/farm/.env
Environment=NODE_ENV=production
# Port: instance 1 → 3000 (canonical internal HTTP / live-view), 2 → 3001, …
ExecStart=/bin/bash -c 'export WORKER_ID="w-%i"; export WORKER_HTTP_PORT="$((2999 + %i))"; exec /usr/bin/node /opt/farm/workers/index.js'
Restart=always
RestartSec=3
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=60
Nice=5
LimitNOFILE=65535
LimitNPROC=65535
TasksMax=infinity

StandardOutput=journal
StandardError=journal
SyslogIdentifier=farm-worker-%i

[Install]
WantedBy=multi-user.target
