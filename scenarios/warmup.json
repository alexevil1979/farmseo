{
  "name": "Warmup 14d",
  "type": "warmup",
  "version": 1,
  "description": "График прогрева аккаунта на 14 дней. Интенсивность зависит от vars.day / payload.day.",
  "defaults": {
    "day": 1,
    "geo": "ru",
    "device": "desktop",
    "limits": {
      "dwell_sec_min": 2,
      "dwell_sec_max": 8,
      "max_scrolls": 8,
      "max_duration_sec": 1800
    },
    "queries": [
      "погода сегодня",
      "курс доллара",
      "новости россии",
      "рецепт борща",
      "как починить кран",
      "расписание электричек",
      "лучший смартфон 2024",
      "фильмы онлайн",
      "яндекс карты пробки",
      "работа вакансии",
      "купить билеты на поезд",
      "что посмотреть вечером",
      "переводчик английский",
      "калькулятор онлайн",
      "спортивные новости"
    ]
  },
  "steps": [
    {
      "type": "goto",
      "url": "https://yandex.ru/",
      "timeout_sec": 60
    },
    {
      "type": "dwell",
      "min": 1,
      "max": 3
    },
    {
      "type": "mouse_move"
    },
    {
      "type": "branch",
      "branch": { "var": "day", "op": "lte", "value": 2 },
      "then": [
        {
          "type": "loop",
          "min": 5,
          "max": 8,
          "steps": [
            { "type": "search_yandex", "query": "{{random_query}}" },
            { "type": "dwell", "min": 2, "max": 6 },
            { "type": "scroll", "min": 200, "max": 700, "times": 2 },
            { "type": "mouse_move", "weight": 0.6 }
          ]
        }
      ],
      "else": [
        {
          "type": "branch",
          "branch": "day <= 7",
          "then": [
            {
              "type": "loop",
              "min": 15,
              "max": 25,
              "steps": [
                { "type": "search_yandex", "query": "{{random_query}}" },
                { "type": "dwell", "min": 2, "max": 5 },
                { "type": "scroll", "min": 250, "max": 900 },
                {
                  "type": "click_serp_position",
                  "min": 1,
                  "max": 4,
                  "weight": 0.35,
                  "on_fail": "continue"
                },
                {
                  "type": "read_article",
                  "min": 2,
                  "max": 5,
                  "weight": 0.3,
                  "on_fail": "continue"
                },
                { "type": "back", "weight": 0.3, "on_fail": "continue" }
              ]
            },
            {
              "type": "loop",
              "min": 1,
              "max": 3,
              "steps": [
                {
                  "type": "visit_service",
                  "services": ["mail", "weather", "news", "market", "images"],
                  "random": true
                },
                { "type": "dwell", "min": 3, "max": 10 },
                { "type": "scroll", "min": 150, "max": 500 }
              ]
            },
            {
              "type": "read_article",
              "min": 3,
              "max": 8,
              "on_fail": "continue"
            }
          ],
          "else": [
            {
              "type": "loop",
              "min": 30,
              "max": 50,
              "steps": [
                { "type": "search_yandex", "query": "{{random_query}}" },
                { "type": "dwell", "min": 2, "max": 6 },
                { "type": "scroll", "min": 300, "max": 1000 },
                {
                  "type": "click_serp_position",
                  "min": 1,
                  "max": 5,
                  "weight": 0.55,
                  "on_fail": "continue"
                },
                {
                  "type": "read_article",
                  "min": 3,
                  "max": 10,
                  "weight": 0.5,
                  "on_fail": "continue"
                },
                {
                  "type": "internal_click",
                  "weight": 0.4,
                  "optional": true,
                  "on_fail": "continue"
                },
                { "type": "back", "weight": 0.45, "on_fail": "continue" },
                {
                  "type": "add_bookmark",
                  "weight": 0.15,
                  "on_fail": "continue"
                }
              ]
            },
            {
              "type": "loop",
              "min": 2,
              "max": 4,
              "steps": [
                {
                  "type": "visit_service",
                  "services": ["mail", "weather", "news", "market", "Картинки"]
                },
                { "type": "dwell", "min": 4, "max": 12 }
              ]
            },
            {
              "type": "branch",
              "branch": { "var": "day", "op": "gte", "value": 10 },
              "then": [
                { "type": "add_bookmark", "on_fail": "continue" },
                { "type": "screenshot", "name": "warmup-late.png" }
              ],
              "else": [
                { "type": "dwell", "min": 1, "max": 2 }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "screenshot",
      "name": "warmup-end.png"
    }
  ]
}
