{
  "name": "E2E Warmup Local",
  "type": "warmup",
  "version": 1,
  "description": "Self-contained warmup against e2e local nginx site (no Yandex, no external net).",
  "defaults": {
    "day": 1,
    "geo": "ru",
    "device": "desktop",
    "limits": {
      "dwell_sec_min": 1,
      "dwell_sec_max": 1,
      "max_scrolls": 2,
      "max_duration_sec": 90
    }
  },
  "steps": [
    {
      "type": "goto",
      "url": "http://site/",
      "timeout_sec": 30
    },
    {
      "type": "dwell",
      "min": 1,
      "max": 1
    },
    {
      "type": "mouse_move"
    },
    {
      "type": "scroll",
      "min": 100,
      "max": 300,
      "times": 1
    },
    {
      "type": "internal_click",
      "timeout_sec": 30
    },
    {
      "type": "dwell",
      "min": 1,
      "max": 1
    },
    {
      "type": "screenshot",
      "name": "e2e-after-click.png"
    },
    {
      "type": "back",
      "timeout_sec": 15
    },
    {
      "type": "dwell",
      "min": 1,
      "max": 1
    },
    {
      "type": "mouse_move"
    },
    {
      "type": "scroll",
      "min": 80,
      "max": 200,
      "times": 1
    },
    {
      "type": "screenshot",
      "name": "e2e-end.png"
    }
  ]
}
