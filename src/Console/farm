#!/usr/bin/env php
<?php

declare(strict_types=1);

use Farm\Db\Connection;
use Farm\Db\Migrator;

$root = dirname(__DIR__, 2);

/** @var array $config */
$config = require $root . DIRECTORY_SEPARATOR . 'app' . DIRECTORY_SEPARATOR . 'bootstrap.php';

$argv = $_SERVER['argv'] ?? [];
array_shift($argv);
$command = $argv[0] ?? 'help';
$args = array_slice($argv, 1);

$exit = match (true) {
    $command === 'migrate' => cmdMigrate($config, $root),
    $command === 'migrate:rollback' => cmdRollback($config, $root, $args),
    $command === 'migrate:status' => cmdMigrateStatus($config, $root),
    $command === 'seed' => cmdSeed($config, $root, $args),
    str_starts_with($command, 'proxy:') => cmdProxy($root, $command, $args),
    str_starts_with($command, 'fp:') => cmdFp($root, $command, $args),
    str_starts_with($command, 'scenario:') => cmdScenario($root, $command, $args),
    str_starts_with($command, 'sched:')
        || str_starts_with($command, 'governor:')
        || str_starts_with($command, 'gc:') => cmdSched($root, $command, $args),
    str_starts_with($command, 'mon:') => cmdMon($root, $command, $args),
    str_starts_with($command, 'token:') => cmdToken($root, $command, $args),
    str_starts_with($command, 'sms:') => cmdSms($root, $command, $args),
    in_array($command, ['help', '--help', '-h'], true) => cmdHelp(),
    default => (static function () use ($command): int {
        fwrite(STDERR, "Unknown command: {$command}\n");
        cmdHelp();

        return 1;
    })(),
};

exit($exit);

/** @param array $config */
function cmdMigrate(array $config, string $root): int
{
    $db = bootstrapDb($config);
    $migrator = new Migrator($db, $root . DIRECTORY_SEPARATOR . 'migrations');
    $applied = $migrator->migrate();
    if ($applied === []) {
        echo "Nothing to migrate.\n";
    } else {
        foreach ($applied as $file) {
            echo "Migrated: {$file}\n";
        }
        echo 'Applied ' . count($applied) . " migration(s).\n";
    }

    return 0;
}

/**
 * @param array $config
 * @param list<string> $args
 */
function cmdRollback(array $config, string $root, array $args): int
{
    $steps = 1;
    foreach ($args as $arg) {
        if (preg_match('/^--steps=(\d+)$/', $arg, $m)) {
            $steps = max(1, (int) $m[1]);
        }
    }

    $db = bootstrapDb($config);
    $migrator = new Migrator($db, $root . DIRECTORY_SEPARATOR . 'migrations');
    $rolled = $migrator->rollback($steps);
    if ($rolled === []) {
        echo "Nothing to rollback.\n";
    } else {
        foreach ($rolled as $file) {
            echo "Rolled back: {$file}\n";
        }
        echo 'Rolled back ' . count($rolled) . " migration(s).\n";
    }

    return 0;
}

/** @param array $config */
function cmdMigrateStatus(array $config, string $root): int
{
    $db = bootstrapDb($config);
    $migrator = new Migrator($db, $root . DIRECTORY_SEPARATOR . 'migrations');
    $migrator->ensureMigrationsTable();
    $applied = $migrator->appliedMigrations();
    $files = $migrator->discoverMigrationFiles();

    foreach ($files as $file) {
        $mark = isset($applied[$file]) ? 'Y' : 'N';
        echo "[{$mark}] {$file}\n";
    }

    return 0;
}

/**
 * @param array $config
 * @param list<string> $args
 */
function cmdSeed(array $config, string $root, array $args): int
{
    $options = [
        'accounts' => 100,
        'proxies' => 20,
        'scenarios' => 3,
        'tasks' => 50,
    ];
    foreach ($args as $arg) {
        if (preg_match('/^--accounts=(\d+)$/', $arg, $m)) {
            $options['accounts'] = (int) $m[1];
        } elseif (preg_match('/^--proxies=(\d+)$/', $arg, $m)) {
            $options['proxies'] = (int) $m[1];
        } elseif (preg_match('/^--scenarios=(\d+)$/', $arg, $m)) {
            $options['scenarios'] = (int) $m[1];
        } elseif (preg_match('/^--tasks=(\d+)$/', $arg, $m)) {
            $options['tasks'] = (int) $m[1];
        }
    }

    $db = bootstrapDb($config);
    /** @var callable $seeder */
    $seeder = require $root . DIRECTORY_SEPARATOR . 'seeds' . DIRECTORY_SEPARATOR . 'demo.php';
    $result = $seeder($db, $options);

    echo "Seed complete:\n";
    foreach ($result as $key => $value) {
        echo "  {$key}: {$value}\n";
    }

    return 0;
}

/**
 * @param list<string> $args
 */
function cmdProxy(string $root, string $command, array $args): int
{
    // Re-build argv for proxy.php: [proxy.php, proxy:cmd|cmd, ...args]
    $proxyCmd = str_starts_with($command, 'proxy:') ? $command : 'proxy:' . $command;
    $_SERVER['argv'] = array_merge(
        [$root . DIRECTORY_SEPARATOR . 'src' . DIRECTORY_SEPARATOR . 'Console' . DIRECTORY_SEPARATOR . 'proxy.php', $proxyCmd],
        $args
    );
    $_SERVER['FARM_PROXY_AS_LIBRARY'] = true;

    /** @var int $code */
    $code = require $root . DIRECTORY_SEPARATOR . 'src' . DIRECTORY_SEPARATOR . 'Console' . DIRECTORY_SEPARATOR . 'proxy.php';

    return (int) $code;
}

