function cmdHelp(): int
{
    echo <<<'HELP'
Farm CLI — data layer + proxy pool + fingerprints + scenarios + scheduler + API

Usage:
  php farm <command> [options]

Commands:
  migrate                 Apply pending migrations
  migrate:rollback        Roll back last batch (--steps=N)
  migrate:status          Show migration status
  seed                    Fill demo data (idempotent)
                          --accounts=100 --proxies=20 --scenarios=3 --tasks=50
  proxy:import <file>     Import proxies (host:port:user:pass)
  proxy:check [--all]     Health-check proxies (ok|slow|dead)
  proxy:rotate            Replace dead assigned proxies (same geo)
  proxy:stats             Pool statistics
  fp:generate --account=  Generate fingerprint for account
  fp:assign --group=      Assign fingerprints to account group
  fp:validate --all       Validate fingerprint consistency
  scenario:run            Run JSON scenario in Chrome
                          --account=ID --scenario=warmup|pf|service [--day=N] [--fast]
  scenario:sync           Upsert scenarios/*.json → DB
  scenario:event          Append runs_events row (internal)
  sched:run [--loop]      Fire schedules + enqueue farm:q:tasks (governor-aware)
  sched:stats             Queue / task / governor snapshot
  governor:status         JSON governor status
  gc:run                  Stale tasks, locks, SingletonLock, orphan Chrome
  mon:watch [--once]      Metrics (cpu/ram/disk/chrome) + alerts every 15s
  mon:test-alert          Send Telegram test alert (TG_TOKEN + TG_CHAT_ID)
  token:issue             Issue API token (--user=ID --name=LABEL)
  token:revoke            Revoke token (--id=ID | --token=PLAIN)
  token:list              List tokens (--user=ID)
  sms:rent                Rent SMS number [--account=ID] [--service=ya]
  sms:code                Wait for SMS code (--phone=ID)
  sms:release             Release number (--phone=ID)
  sms:cancel              Cancel activation (--phone=ID)
  help                    Show this help

HELP;

    return 0;
}

/** @param array $config */
function bootstrapDb(array $config): Connection
{
    Connection::reset();

    return Connection::getInstance($config['db']);
}
