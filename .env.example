DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=farm
DB_USERNAME=root
DB_PASSWORD=
DB_TEST_DATABASE=farm_test

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=2.0

APP_KEY=farm-dev-change-me
API_URL=http://127.0.0.1
INTERNAL_TOKEN=change-me
IPINFO_TOKEN=
# Geo lookup: http (ip-api/ipinfo via proxy) | stub (e2e/geo-fixtures.json, no outbound HTTP)
# WSL/e2e: use stub — no external HTTP during acceptance runs.
GEO_PROVIDER=stub
GEO_FIXTURES=
PROXY_SLOW_MS=2000
PROXY_CHECK_TIMEOUT=12
PROXY_BAD_ASN=
TG_TOKEN=
TG_CHAT_ID=
TG_DEDUPE_SEC=300
MONITOR_INTERVAL_SEC=15
MONITOR_PROXY_DEAD_PCT=20
MONITOR_CAPTCHA_WINDOW_SEC=300
MONITOR_CAPTCHA_THRESHOLD=5
MONITOR_DISK_PCT=95
CAPTCHA_PROVIDER=2captcha
CAPTCHA_KEY=
CAPTCHA_TOKEN_URL=
SMS_PROVIDER=sms-activate
SMS_KEY=
SMS_API_URL=
SMS_SERVICE=ya
SMS_COUNTRY=0
SMS_RENT_MINUTES=20
SMS_POLL_INTERVAL_SEC=5
SMS_WAIT_TIMEOUT_SEC=180
# WSL/e2e: preflight requires MAX_CHROME<=2. Production: see docs/capacity.md (often 40).
MAX_CHROME=2
WORKER_SLOTS=2
WORKER_HTTP_PORT=3000
CHROME_HEADLESS=false
# WSL/Docker/e2e: --no-sandbox required (scripts/preflight.sh). Also disable-dev-shm-usage with shm_size=1gb.
CHROME_EXTRA_ARGS=--no-sandbox --disable-dev-shm-usage --disable-gpu
VNC_BASE_PORT=5900
WEBSOCKIFY_BASE_PORT=6080
DISPLAY_BASE=99
XVFB_SCREEN=1920x1080x24
NOVNC_WEB_PATH=/usr/share/novnc
LIVE_VIEW_IDLE_SEC=600
WORKER_URL=http://127.0.0.1:3000
# Multi-node sticky: NODE_ID must match nodes.id; NODE_ADDRESS is this worker's internal HTTP base
NODE_ID=
NODE_ADDRESS=http://127.0.0.1:3000
RESULT_URL=http://127.0.0.1/internal/task/result
QUEUE_BRPOP_TIMEOUT=5
RECLAIM_INTERVAL_MS=15000
RECLAIM_STALE_SEC=45
ACCOUNT_LOCK_TTL=600
PROXY_LOCK_TTL=120
KEEP_OPEN_MIN_MS=3000
KEEP_OPEN_MAX_MS=15000
GOVERNOR_CPU_PCT=80
GOVERNOR_RAM_PCT=90
NIGHT_WINDOW_START=23:00
NIGHT_WINDOW_END=07:00
RETRY_BASE_SEC=30
RETRY_MAX_SEC=900
SCHED_ENQUEUE_BATCH=50
GC_STALE_GRACE_SEC=60
GC_KILL_ORPHAN_CHROME=1
# Profile migration between nodes (local disk + rsync/SSH; not NFS primary)
PROFILE_SSH_KEY=
PROFILE_SSH_USER=farm
PROFILE_SSH_PORT=22
PROFILE_REMOTE_ROOT=/opt/farm/storage/profiles
PROFILE_MIGRATE_MAX=2
PROFILE_MIGRATE_STAGING=
